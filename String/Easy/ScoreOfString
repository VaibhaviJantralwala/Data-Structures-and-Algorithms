class Solution {
    public int scoreOfString(String s) {
        int ptr1 = 0;
        int ptr2 = 0;
        int score = 0;
        for(int i=0 ; i<s.length()-1 ; i++){
            ptr1 = s.charAt(i);
            ptr2 = s.charAt(i+1);
            int ans = Math.abs(ptr1 - ptr2);
            score += ans;
        }
        return score;
    }
}
